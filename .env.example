APP_NAME=Laravel
MANAGER_OZON_FBO_ENABLED=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=https://sellico.ru,https://www.sellico.ru

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_VERBOSE_PRODUCT_INDEX=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=2100

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Marketplace API Keys
WILDBERRIES_API_KEY=
OZON_CLIENT_ID=
OZON_API_KEY=
YANDEX_MARKET_TOKEN=
YANDEX_MARKET_CAMPAIGN_ID=
# Опционально: если не задан, подставится из GET /v2/campaigns/{campaignId}
YANDEX_MARKET_BUSINESS_ID=

# Stop FBS mutations in the manager and shared order guard; read/download remains available.
MANAGER_FBS_WRITES_ENABLED=true
MANAGER_OZON_CARRIAGES_ENABLED=false
MANAGER_WB_SUPPLIES_ENABLED=false

# Local price-review drafts; does not enable price publication.
MANAGER_PRICE_PROPOSALS_ENABLED=false
MANAGER_PRICE_EXECUTION_ENABLED=false
MANAGER_PRICE_EXECUTOR_URL=

# Personal Ozon group packing and its approved-only outbox. Both remain off until acceptance.
MANAGER_OZON_PACKING_ENABLED=false
MANAGER_OZON_PACKING_OUTBOX_ENABLED=false

# Separate internal Products -> Ads price-dispatch credential (at least 32 bytes).
PRICE_DISPATCH_GATE_SECRET=
PRICE_DISPATCH_GATE_URL=
# Direct Products price senders are retired; prices change only through personally approved commands.
PRICE_LEGACY_DISPATCH_ENABLED=false

# Personal stop/manual_only for supported Products FBS senders; requires journal migration.
MANAGER_FBS_EXECUTION_CONTROLS_ENABLED=false
